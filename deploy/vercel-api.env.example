# VERCEL / EXPRESS API ENVIRONMENT — server-only values
NODE_ENV=production
API_PORT=4000
# The Express API needs PostgreSQL today for events, gaming LFG, academic resources and Place.
DATABASE_URL=postgresql://user:password@host:5432/nexus
# Matching RSA PUBLIC key. Never configure API_TOKEN_PRIVATE_KEY on Vercel.
API_TOKEN_PUBLIC_KEY=
# Exact allowed browser origins, comma-separated, no wildcard and no trailing slash.
ALLOWED_ORIGINS=https://your-site.netlify.app
# Configure managed Redis for cross-instance rate limiting. Do not treat memory fallback as production protection.
REDIS_URL=
API_DB_POOL_MAX=2
TRUST_PROXY_HOPS=1
