# NETLIFY / SVELTEKIT SERVER ENVIRONMENT — CURRENT STAGED ARCHITECTURE
# IMPORTANT: this app is not yet a static/frontend-only build. Legacy SvelteKit server routes
# still serve authentication, posts, comments, moderation and media signing, so DATABASE_URL
# must remain configured on Netlify until those domains are migrated to Express.
# Do not copy this file into a browser bundle or expose any value below as PUBLIC_/VITE_.

# Database (required by current SvelteKit server routes)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# App
ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
SETUP_COMPLETE=false

# Auth (better-auth)
BETTER_AUTH_SECRET=your-32-char-random-secret
REQUIRE_EMAIL_VERIFICATION=false

# Backblaze B2 (server-only credentials; never use VITE_ for keys)
B2_KEY_ID=your-key-id
B2_APP_KEY=your-application-key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# Must match the access setting of B2_BUCKET_NAME in the Backblaze console.
# private is the default. Photos/GIFs use a same-origin app proxy; large media/video/audio use signed B2 URLs
# to avoid Netlify stream limits. Set B2_MEDIA_DELIVERY=redirect to use signed URLs for all media.
# public enables direct public media URLs, but objects in that bucket cannot be private individually.
B2_BUCKET_ACCESS=private
# Private-bucket delivery: photos/GIFs use the same-origin proxy by default; video/audio use signed B2 URLs
# to avoid Netlify streaming response limits. Set to redirect to bypass the proxy for all media.
B2_MEDIA_DELIVERY=proxy
# Optional second bucket to mix access levels. Use the same region/endpoint and an app key permitted for both.
# If the primary bucket is private, this bucket receives confirmed-public assets (optional).
B2_PUBLIC_BUCKET_NAME=
# If the primary bucket is public, this bucket stores private/community-bound assets (strongly recommended).
B2_PRIVATE_BUCKET_NAME=
# Optional HTTPS base URL/CDN root for the public bucket only; leave blank to derive the B2 URL.
# If the primary bucket is public, this must point to the primary bucket; when B2_PUBLIC_BUCKET_NAME is set, point here to that secondary public bucket. Do not set this for a private bucket.
B2_PUBLIC_URL=
# Restricted S3-compatible app keys need readBuckets for ACL verification and listAllBucketNames for HeadBucket checks.

# Optional OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Production notes
# Match B2_BUCKET_ACCESS to the actual bucket privacy in Backblaze. Do not change an existing private bucket to public if it contains private media.
# Never expose B2_APP_KEY in client-side variables. Configure B2 bucket CORS for direct signed PUT uploads; it does not make a private bucket public. See docs/backblaze-private-bucket-cors.example.json.
# Set PUBLIC_SITE_URL/ORIGIN to the exact HTTPS production URL before launch.

# Optional GIF picker search providers (Tenor API v2 and GIPHY). Configure either or both.
TENOR_API_KEY=
GIPHY_API_KEY=

# Separate Express API trust bridge. The frontend runtime mints five-minute tokens after Better Auth session validation.
PUBLIC_API_BASE_URL=http://localhost:4000
# RSA PRIVATE key: Netlify server environment ONLY. Never put this in Vercel, git or client code.
API_TOKEN_PRIVATE_KEY=

# Note: API_PORT, API_TOKEN_PUBLIC_KEY, ALLOWED_ORIGINS, REDIS_URL, and API_DB_POOL_MAX
# belong in api/.env.example / the Vercel API project, not this Netlify environment.
